{
  "name": "forkpoint",
  "version": "0.1.0",
  "description": "Record once. Replay deterministically. Find the fork.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "forkpoint": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agents",
    "deterministic-replay",
    "developer-tools",
    "llm",
    "testing",
    "typescript"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && npm run build:plugin",
    "build:plugin": "tsup --config tsup.plugin.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx examples/sql-agent/index.ts",
    "record:demo": "tsx src/cli/index.ts record --name sql-agent-fail -- tsx examples/sql-agent/index.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "openai": "^7.39.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
